#!/usr/bin/env -S uv run --quiet --python 3.14 --script
# Claude Code owns the rest of this file, and writes it without a trailing
# newline; patch only the managed keys and match that.
import json
import sys

context7_api_key = {{ .secrets.context7ApiKey | toJson }}

source = sys.stdin.read()
config = json.loads(source) if source.strip() else {}
config["autoInstallIdeExtension"] = False
config.setdefault("mcpServers", {})["context7"] = {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {"CONTEXT7_API_KEY": context7_api_key},
}

sys.stdout.write(json.dumps(config, indent=2, ensure_ascii=False))
