[user]
	name = Yegor Usoltsev
	email = yegor@usoltsev.xyz
	useConfigOnly = true

[core]
	autocrlf = input
	editor = micro
	excludesfile = ~/.gitignore
	ignorecase = false
	pager = delta
	quotepath = false
	trustctime = false
	untrackedCache = true

[credential]
	# Reset inherited helpers; host-specific lists are unaffected.
	helper =
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = store
{{- end }}

{{- if dig "githubToken" "" .secrets }}
[credential "https://github.com"]
	helper =
	helper = store --file ~/.config/git/github.credentials
{{- end }}
{{- if dig "giteaToken" "" .secrets }}
[credential "https://gitea.usoltsev.xyz"]
	helper =
	helper = store --file ~/.config/git/gitea.credentials
{{- end }}

[delta]
	hyperlinks = true
	line-numbers = true
	navigate = true

[diff]
	algorithm = histogram
	colorMoved = default
{{- if ne .profile "server" }}

# Git 2.54 config-based hook: runs a repository's prek or pre-commit config on
# every commit without `prek install`, alongside the repository's own hooks.
# GUI clients may lack the mise shims on PATH, so the command appends them.
[hook "prek"]
	event = pre-commit
	command = PATH=\"$PATH:$HOME/.local/share/mise/shims\" prek hook-impl --hook-type pre-commit --skip-on-missing-config --
{{- end }}

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictStyle = zdiff3

[push]
	autoSetupRemote = true
