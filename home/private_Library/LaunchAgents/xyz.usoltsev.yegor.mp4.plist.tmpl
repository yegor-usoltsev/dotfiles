{{- /* Shell-quote, then XML-escape. */ -}}
{{- $mp4 := joinPath .chezmoi.homeDir ".local/bin/mp4" | shellQuote -}}
{{- $screenshots := .screenshotsPath | shellQuote -}}
{{- $command := printf "for f in %s/*.mov(.N); do %s \"$f\"; done" $screenshots $mp4 -}}
{{- $path := printf "%s/.local/bin:%s/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" .chezmoi.homeDir .chezmoi.homeDir -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>xyz.usoltsev.yegor.mp4</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>{{ $command | replace "&" "&amp;" | replace "<" "&lt;" | replace ">" "&gt;" }}</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MP4_TRASH_ORIGINAL</key>
		<string>1</string>
		<key>MP4_NOTIFY</key>
		<string>1</string>
		<key>PATH</key>
		<string>{{ $path | replace "&" "&amp;" | replace "<" "&lt;" | replace ">" "&gt;" }}</string>
	</dict>
	<key>WatchPaths</key>
	<array>
		<string>{{ .screenshotsPath | replace "&" "&amp;" | replace "<" "&lt;" | replace ">" "&gt;" }}</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
