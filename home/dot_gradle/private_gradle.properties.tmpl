{{- with dig "githubToken" "" .secrets -}}
githubUsername={{ $.githubLogin }}
githubToken={{ . | replace "\\" "\\\\" }}
{{ end -}}
{{- with dig "giteaToken" "" .secrets -}}
giteaUsername={{ $.giteaLogin }}
giteaToken={{ . | replace "\\" "\\\\" }}
{{ end -}}
{{- if and (eq .chezmoi.os "linux") (eq .profile "devbox") -}}
{{-   with get . "gradleJvmArgs" -}}
org.gradle.jvmargs={{ . }}
{{ end -}}
{{ end -}}
