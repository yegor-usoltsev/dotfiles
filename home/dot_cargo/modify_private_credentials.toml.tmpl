#!/usr/bin/env -S uv run --quiet --no-project --python 3.14 --with tomlkit==0.15.1 --script
# Cargo's default cargo:token provider reads these registry tokens.
import sys

import tomlkit

owners = {{ .giteaPackageOwners | toJson }}
token = {{ dig "giteaToken" "" .secrets | toJson }}


def child(parent, key):
    """Return parent[key], replacing a missing or null value with an empty table."""
    if parent.get(key) is None:
        parent[key] = {}
    return parent[key]


config = tomlkit.parse(sys.stdin.read())
registries = child(config, "registries")
for owner in owners:
    child(registries, f"gitea-{owner}")["token"] = f"Bearer {token}"

sys.stdout.write(tomlkit.dumps(config))
