#!/usr/bin/env -S uv run --quiet --no-project --no-managed-python --offline --script
# The Paseo daemon owns the rest of this file: installed plugins, terminal
# profiles and anything changed in Settings. Patch only the managed keys.
import json
import socket
import subprocess
import sys
from pathlib import Path

system_prompt = {{ includeTemplate ".chezmoitemplates/paseo-system-prompt" . | trim | toJson }}


def output(*command):
    """Return a command's trimmed output, or "" when it is missing or fails."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def child(parent, key):
    """Return parent[key], replacing a missing or null value with an empty table."""
    if parent.get(key) is None:
        parent[key] = {}
    return parent[key]


source = sys.stdin.read()
config = json.loads(source.strip() or "{}") or {}
config.update(
    {
        "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
        "version": 1,
        "pluginsEnabled": True,
    }
)

agents = child(config, "agents")
# The paseo skill comes from this repository. With the default "all" selection
# the daemon reinstalls its bundled skills on startup and overwrites it.
child(agents, "skills")["selection"] = {"mode": "custom", "skills": []}

daemon = child(config, "daemon")
# Appended to the system prompt of every Paseo agent.
daemon["appendSystemPrompt"] = system_prompt
child(daemon, "mcp").update(enabled=True, injectIntoAgents=True)

providers = child(agents, "providers")
# paseo-peer replaces send_agent_prompt, which interrupts a busy recipient.
for name in ("claude", "codex"):
    tools = child(child(providers, name), "paseoTools")
    tools["disabledTools"] = ["send_agent_prompt"]
for name in ("antigravity", "copilot", "muse", "opencode", "pi"):
    child(providers, name)["enabled"] = False

# Both juniors fill one role, so they share its notes.
junior_notes = "Junior: fast and inexpensive, for simple routine work under a senior's supervision: mechanical edits, well-specified small changes, test and documentation updates, and exploration such as searches, symbol tracing and fact checks. Follows the brief, reports evidence and uncertainty to the agent that started it, and leaves significant decisions, unclear requirements and scope changes to that agent."

# Role IDs stay stable when a model version changes. Manage the complete
# four-profile list so retired profiles do not remain as duplicate roles.
daemon["agentProfiles"] = [
    {
        "id": "agent_profile_claude_senior",
        "name": "claude-senior",
        "icon": "brain",
        "color": "orange",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "modeId": "bypassPermissions",
        "thinkingOptionId": "high",
        "notes": "Senior peer: an equal colleague to the other senior for owning a task, planning, implementing and independent review. Strongest at ambiguous requirements, architecture and keeping the overall goal in view.",
    },
    {
        "id": "agent_profile_codex_senior",
        "name": "codex-senior",
        "icon": "brain",
        "color": "blue",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "notes": "Senior peer: an equal colleague to the other senior for owning a task, planning, implementing and independent review. Strongest at iterative implementation, debugging and tests.",
    },
    {
        "id": "agent_profile_claude_junior",
        "name": "claude-junior",
        "icon": "hammer",
        "color": "orange",
        "provider": "claude",
        "model": "claude-haiku-5-5",
        "modeId": "bypassPermissions",
        "thinkingOptionId": "xhigh",
        "notes": junior_notes,
    },
    {
        "id": "agent_profile_codex_junior",
        "name": "codex-junior",
        "icon": "hammer",
        "color": "blue",
        "provider": "codex",
        "model": "gpt-6-luna",
        "modeId": "full-access",
        "thinkingOptionId": "xhigh",
        "notes": junior_notes,
    },
]

if sys.platform == "linux":
    host = socket.gethostname().split(".")[0]
    origins = [f"http://{host}:6767", "http://localhost:6767"]
    # Tailscale may be installed but not yet up on a fresh host.
    tailscale_status = output("tailscale", "status", "--json")
    if tailnet := json.loads(tailscale_status or "{}").get("MagicDNSSuffix"):
        origins.append(f"http://{host}.{tailnet}:6767")
    if tailscale_ip := output("tailscale", "ip", "-4").partition("\n")[0]:
        origins.append(f"http://{tailscale_ip}:6767")

    daemon["listen"] = "0.0.0.0:6767"
    daemon["hostnames"] = [host, f".{host}"]
    child(daemon, "cors")["allowedOrigins"] = origins
    # Phones reach this host over Tailscale, not through the relay.
    child(daemon, "relay")["enabled"] = False
    child(config, "app")["baseUrl"] = f"http://{host}:6767"
    child(config, "worktrees")["root"] = str(Path.home() / "paseo" / "worktrees")
    features = child(config, "features")
    for name in ("dictation", "voiceMode"):
        child(features, name)["enabled"] = False
    child(features, "webUi")["enabled"] = True

print(json.dumps(config, indent=2, ensure_ascii=False))
