#!/bin/sh
set -eu

# The Paseo daemon owns the rest of this file: installed plugins, terminal
# profiles and anything changed in Settings. Patch only the managed keys.
{{- if eq .chezmoi.os "linux" }}
{{- $host := .chezmoi.hostname }}
{{- $hostnames := list $host (printf ".%s" $host) }}
{{- $origins := list (printf "http://%s:6767" $host) "http://localhost:6767" }}
{{- /* Tailscale may be installed but not yet up on a fresh host. */}}
{{- $tailnet := output "sh" "-c" "tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty' || true" | trim }}
{{- $tailscaleIp := output "sh" "-c" "tailscale ip -4 2>/dev/null | head -n 1 || true" | trim }}
{{- if $tailnet }}
{{- $origins = append $origins (printf "http://%s.%s:6767" $host $tailnet) }}
{{- end }}
{{- if $tailscaleIp }}
{{- $origins = append $origins (printf "http://%s:6767" $tailscaleIp) }}
{{- end }}
PASEO_HOSTNAMES={{ join " " $hostnames | shellQuote }}
PASEO_ORIGINS={{ join " " $origins | shellQuote }}
PASEO_BASE_URL={{ printf "http://%s:6767" $host | shellQuote }}
PASEO_WORKTREES={{ joinPath .chezmoi.homeDir "paseo" "worktrees" | shellQuote }}
export PASEO_HOSTNAMES PASEO_ORIGINS PASEO_BASE_URL PASEO_WORKTREES
{{- end }}

jq -s '
    (.[0] // {})
    | ."$schema" = "https://paseo.sh/schemas/paseo.config.v1.json"
    | .version = 1
    | .pluginsEnabled = true
    # The paseo and paseo-peers skills come from this repository. With the
    # default "all" selection the daemon reinstalls its bundled skills on
    # startup and overwrites the adapted paseo skill.
    | .agents.skills.selection = { "mode": "custom", "skills": [] }
    | .daemon.mcp.enabled = true
    | .daemon.mcp.injectIntoAgents = true
    # paseo-peer replaces send_agent_prompt, which interrupts a busy recipient.
    | ["send_agent_prompt"] as $disabled
    | .agents.providers.claude.paseoTools.disabledTools = $disabled
    | .agents.providers.codex.paseoTools.disabledTools = $disabled
    | .agents.providers.copilot.enabled = false
    | .agents.providers.opencode.enabled = false
    | .agents.providers.pi.enabled = false
    # Role IDs stay stable when a model version changes. Manage the complete
    # four-profile list so retired profiles do not remain as duplicate roles.
    | .daemon.agentProfiles = [
        {
          "id": "agent_profile_claude_senior",
          "name": "claude-senior",
          "icon": "brain",
          "color": "orange",
          "provider": "claude",
          "model": "claude-opus-5-5",
          "modeId": "bypassPermissions",
          "thinkingOptionId": "high",
          "notes": "Equal senior colleague for paired work with codex-senior on complex implementation and independent review. Prefer for ambiguous requirements, architecture and maintaining the overall goal. Either senior may own the task, implement or review; treat the counterpart as an equal. Delegate scoped implementation to claude-worker and narrow read-only checks to codex-scout. Coordinate through peer.send and agree file ownership."
        },
        {
          "id": "agent_profile_codex_senior",
          "name": "codex-senior",
          "icon": "brain",
          "color": "blue",
          "provider": "codex",
          "model": "gpt-6.1-sol",
          "modeId": "full-access",
          "thinkingOptionId": "high",
          "notes": "Equal senior colleague for paired work with claude-senior on complex engineering and independent review. Prefer for iterative implementation, debugging and tests. Either senior may own the task, plan or make architectural decisions; treat the counterpart as an equal. Delegate scoped implementation to claude-worker and narrow read-only checks to codex-scout. Coordinate through peer.send and agree file ownership."
        },
        {
          "id": "agent_profile_claude_worker",
          "name": "claude-worker",
          "icon": "hammer",
          "color": "orange",
          "provider": "claude",
          "model": "claude-sonnet-5-5",
          "modeId": "bypassPermissions",
          "thinkingOptionId": "medium",
          "notes": "Primary implementation subagent for scoped coding, refactoring, tests, documentation and substantial repository investigation. Use when the work needs more understanding than a narrow scout lookup. Own assigned files, verify changes and report evidence to the delegating senior. Escalate unclear requirements or changes beyond the assigned scope; do not start a senior counterpart automatically."
        },
        {
          "id": "agent_profile_codex_scout",
          "name": "codex-scout",
          "icon": "eye",
          "color": "blue",
          "provider": "codex",
          "model": "gpt-6-luna",
          "modeId": "full-access",
          "thinkingOptionId": "max",
          "notes": "Fast, inexpensive read-only subagent for narrow searches, symbol tracing, structured-data extraction and factual checks. Keep tasks simple, explicit and easy to verify. Return concise evidence and uncertainties to the delegating senior. Never edit files or change services; use claude-worker for implementation or deeper analysis. Do not start a senior counterpart automatically."
        }
      ]
{{- if eq .chezmoi.os "linux" }}
    | .daemon.listen = "0.0.0.0:6767"
    | .daemon.hostnames = (env.PASEO_HOSTNAMES | split(" "))
    | .daemon.cors.allowedOrigins = (env.PASEO_ORIGINS | split(" "))
    # Phones reach this host over Tailscale, not through the relay.
    | .daemon.relay.enabled = false
    | .app.baseUrl = env.PASEO_BASE_URL
    | .worktrees.root = env.PASEO_WORKTREES
    | .features.dictation.enabled = false
    | .features.voiceMode.enabled = false
    | .features.webUi.enabled = true
{{- end }}
    '
