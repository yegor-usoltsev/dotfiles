#!/usr/bin/env -S uv run --quiet --python 3.14 --script
# The Paseo daemon owns the rest of this file: installed plugins, terminal
# profiles and anything changed in Settings. Patch only the managed keys.
import json
import socket
import subprocess
import sys
from pathlib import Path

system_prompt = {{ includeTemplate ".chezmoitemplates/paseo-system-prompt" . | trim | toJson }}


def output(*command):
    """Return a command's trimmed output, or "" when it is missing or fails."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


source = sys.stdin.read()
config = json.loads(source) if source.strip() else {}
config.update(
    {
        "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
        "version": 1,
        "pluginsEnabled": True,
    }
)

agents = config.setdefault("agents", {})
# The paseo skill comes from this repository. With the default "all" selection
# the daemon reinstalls its bundled skills on startup and overwrites it.
agents.setdefault("skills", {})["selection"] = {"mode": "custom", "skills": []}

daemon = config.setdefault("daemon", {})
# Appended to the system prompt of every Paseo agent.
daemon["appendSystemPrompt"] = system_prompt
daemon.setdefault("mcp", {}).update(enabled=True, injectIntoAgents=True)

providers = agents.setdefault("providers", {})
# paseo-peer replaces send_agent_prompt, which interrupts a busy recipient.
for name in ("claude", "codex"):
    tools = providers.setdefault(name, {}).setdefault("paseoTools", {})
    tools["disabledTools"] = ["send_agent_prompt"]
for name in ("copilot", "opencode", "pi"):
    providers.setdefault(name, {})["enabled"] = False

# Role IDs stay stable when a model version changes. Manage the complete
# four-profile list so retired profiles do not remain as duplicate roles.
daemon["agentProfiles"] = [
    {
        "id": "agent_profile_claude_senior",
        "name": "claude-senior",
        "icon": "brain",
        "color": "orange",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "modeId": "bypassPermissions",
        "thinkingOptionId": "high",
        "notes": "Senior peer: an equal colleague to the other senior for owning a task, planning, implementing and independent review. Strongest at ambiguous requirements, architecture and keeping the overall goal in view.",
    },
    {
        "id": "agent_profile_codex_senior",
        "name": "codex-senior",
        "icon": "brain",
        "color": "blue",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "notes": "Senior peer: an equal colleague to the other senior for owning a task, planning, implementing and independent review. Strongest at iterative implementation, debugging and tests.",
    },
    {
        "id": "agent_profile_claude_worker",
        "name": "claude-worker",
        "icon": "hammer",
        "color": "orange",
        "provider": "claude",
        "model": "claude-sonnet-5-5",
        "modeId": "bypassPermissions",
        "thinkingOptionId": "medium",
        "notes": "Implementation worker: scoped coding, refactoring, tests, documentation and substantial repository investigation. Works within the assigned files, commits and reports evidence to the agent that started it. Escalates unclear requirements or scope changes to that agent instead of starting peers.",
    },
    {
        "id": "agent_profile_codex_scout",
        "name": "codex-scout",
        "icon": "eye",
        "color": "blue",
        "provider": "codex",
        "model": "gpt-6-luna",
        "modeId": "full-access",
        "thinkingOptionId": "max",
        "notes": "Fast, inexpensive read-only scout: narrow searches, symbol tracing, data extraction and factual checks with an easily verified answer. Returns concise evidence and uncertainty to the agent that started it. Never edits files or changes services; implementation and deeper analysis belong to a worker.",
    },
]

if sys.platform == "linux":
    host = socket.gethostname().split(".")[0]
    origins = [f"http://{host}:6767", "http://localhost:6767"]
    # Tailscale may be installed but not yet up on a fresh host.
    tailscale_status = output("tailscale", "status", "--json")
    if tailnet := json.loads(tailscale_status or "{}").get("MagicDNSSuffix"):
        origins.append(f"http://{host}.{tailnet}:6767")
    if tailscale_ip := output("tailscale", "ip", "-4").partition("\n")[0]:
        origins.append(f"http://{tailscale_ip}:6767")

    daemon["listen"] = "0.0.0.0:6767"
    daemon["hostnames"] = [host, f".{host}"]
    daemon.setdefault("cors", {})["allowedOrigins"] = origins
    # Phones reach this host over Tailscale, not through the relay.
    daemon.setdefault("relay", {})["enabled"] = False
    config.setdefault("app", {})["baseUrl"] = f"http://{host}:6767"
    config.setdefault("worktrees", {})["root"] = str(Path.home() / "paseo" / "worktrees")
    features = config.setdefault("features", {})
    for name in ("dictation", "voiceMode"):
        features.setdefault(name, {})["enabled"] = False
    features.setdefault("webUi", {})["enabled"] = True

print(json.dumps(config, indent=2, ensure_ascii=False))
