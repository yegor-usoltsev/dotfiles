# Host key verification is disabled deliberately; first so no include wins.
Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m

    ServerAliveCountMax 3
    ServerAliveInterval 60

    SetEnv TERM=xterm-256color

    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    GlobalKnownHostsFile /dev/null
    # Keys are deliberately not persisted; omit the misleading added-key notice.
    LogLevel ERROR

    # Match the infrastructure firewall; OpenSSH ignores the tssh extension.
    IgnoreUnknown TsshdPort
    TsshdPort 61000-61100
{{ if eq .chezmoi.os "darwin" }}
# OrbStack keeps its host, identity and proxy settings.
Include ~/.orbstack/ssh/config
{{ end -}}
