{{- $profile := "workstation" -}}
{{- if ne .chezmoi.os "darwin" -}}
{{-   $profile = promptStringOnce . "profile" "profile" "server" -}}
{{-   if not (has $profile (list "server" "devbox")) -}}
{{-     fail "Linux profile must be server or devbox" -}}
{{-   end -}}
{{- end -}}
{{- $installAppsFromAppStore := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $installAppsFromAppStore = promptBoolOnce . "installAppsFromAppStore" "Do you want to install apps from the App Store" -}}
{{- end -}}
{{- $secretsPath := joinPath .chezmoi.homeDir ".config/chezmoi/secrets.toml" -}}
{{- $secrets := dict -}}
{{- if stat $secretsPath -}}
{{-   $secrets = include $secretsPath | fromToml -}}
{{- else -}}
{{-   $aiRouter := rbwFields "ai-router.usoltsev.xyz (gateway, proxy, cli, api)" -}}
{{-   $sshKey := rbw "SSH key" -}}
{{-   $github := rbwFields "github.com (yegor-usoltsev)" -}}
{{-   $gitea := rbwFields "gitea.usoltsev.xyz (yegor)" -}}
{{-   $drone := rbwFields "drone.usoltsev.xyz (yegor)" -}}
{{-   $docker := rbwFields "docker.com (yusoltsev)" -}}
{{-   $cloudflare := rbwFields "cloudflare.com (yegor)" -}}
{{-   $flint := rbwFields "flint.usoltsev.xyz" -}}
{{-   $secrets = dict
        "aiRouterApiKey" (dig "API Key 1" "value" "" $aiRouter)
        "githubToken" (dig "fleet-cli" "value" "" $github)
        "giteaToken" (dig "fleet-cli" "value" "" $gitea)
        "droneToken" (dig "fleet-cli" "value" "" $drone)
        "dockerToken" (dig "fleet-cli" "value" "" $docker)
        "cloudflareAccountId" (dig "Account ID" "value" "" $cloudflare)
        "cloudflareApiToken" (dig "API Token" "value" "" $cloudflare)
        "flintToken" (dig "fleet-cli" "value" "" $flint)
        "sshPublicKey" $sshKey.data.public_key
        "sshPrivateKey" $sshKey.data.private_key
-}}
{{- end -}}
sourceDir = "{{ .chezmoi.homeDir }}/dev/yegor-usoltsev/dotfiles"

[hooks.read-source-state.pre]
command = "{{ .chezmoi.sourceDir }}/.chezmoihooks/ensure-prerequisites.sh"

[diff]
exclude = ["scripts"]

[status]
exclude = ["scripts"]

[data]
installAppsFromAppStore = {{ $installAppsFromAppStore }}
profile = {{ $profile | quote }}
screenshotsPath = "{{ .chezmoi.homeDir }}/Pictures/Screenshots"

[data.secrets]
aiRouterApiKey = {{ dig "aiRouterApiKey" "" $secrets | quote }}
sshPrivateKey = {{ dig "sshPrivateKey" "" $secrets | quote }}
sshPublicKey = {{ dig "sshPublicKey" "" $secrets | quote }}
githubToken = {{ dig "githubToken" "" $secrets | quote }}
giteaToken = {{ dig "giteaToken" "" $secrets | quote }}
droneToken = {{ dig "droneToken" "" $secrets | quote }}
dockerToken = {{ dig "dockerToken" "" $secrets | quote }}
cloudflareAccountId = {{ dig "cloudflareAccountId" "" $secrets | quote }}
cloudflareApiToken = {{ dig "cloudflareApiToken" "" $secrets | quote }}
flintToken = {{ dig "flintToken" "" $secrets | quote }}
