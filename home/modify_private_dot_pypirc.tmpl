#!/usr/bin/env python3
# Twine and Hatch read upload credentials from ~/.pypirc; GitHub has no PyPI registry.
# Patch one section per Gitea owner and keep other repositories.
import configparser
import sys

token = {{ dig "giteaToken" "" .secrets | toJson }}
owners = {{ .giteaPackageOwners | toJson }}

config = configparser.RawConfigParser()
config.read_string(sys.stdin.read())
if not config.has_section("distutils"):
    config.add_section("distutils")
servers = config.get("distutils", "index-servers", fallback="").split()
for owner in owners:
    name = "gitea-" + owner
    if name not in servers:
        servers.append(name)
    if not config.has_section(name):
        config.add_section(name)
    config.set(name, "repository", "https://gitea.usoltsev.xyz/api/packages/" + owner + "/pypi")
    config.set(name, "username", "yegor")
    config.set(name, "password", token)
config.set("distutils", "index-servers", " ".join(servers))
config.write(sys.stdout)
