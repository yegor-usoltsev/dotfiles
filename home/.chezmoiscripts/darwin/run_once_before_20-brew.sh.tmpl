#!/usr/bin/env bash
set -euo pipefail

{{ template "script-header" . }}

info "Adding taps"
{{ range .packages.taps -}}
brew trust --tap {{ . | quote }}
brew tap {{ . | quote }}
{{ end -}}
success "Taps added"

# Explicit kinds keep a formula alias from stealing a cask name (transmission).
# --adopt accepts applications already installed in /Applications.
info "Installing formulae"
brew install {{ range .packages.brews }}{{ . | quote }} {{ end }}
success "Formulae installed"

info "Installing casks"
brew install --cask --adopt {{ range .packages.casks }}{{ . | quote }} {{ end }}
success "Casks installed"

{{ if .installAppsFromAppStore }}
# Without Spotlight, mas reports no installed apps and asks sudo to reinstall them.
export MAS_NO_AUTO_INDEX=1
if mdutil -s / 2>/dev/null | grep -q "Indexing enabled"; then
	info "Installing MAS apps"
	brew bundle --file=/dev/stdin <<EOF
{{ range $name, $id := .packages.mas }}
mas {{ $name | quote }}, id: {{ $id }}
{{ end }}
EOF
	success "MAS apps installed"
else
	warn "Spotlight indexing is disabled; skipping App Store apps"
fi
{{ end }}

info "Installing VSCode extensions"
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.vscode }}
vscode {{ . | quote }}
{{ end }}
EOF
success "VSCode extensions installed"
