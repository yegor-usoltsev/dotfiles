#!/usr/bin/env bash
set -euo pipefail

{{ template "script-header" . }}

{{ if .packages.taps }}
info "Adding taps"
{{ range .packages.taps }}
brew tap {{ . | quote }}
{{ end }}
success "Taps added"
{{ end }}

# One `brew install` per kind rather than `brew bundle`: bundle resolves a name
# before it honours the `cask` keyword, so a cask whose name is also an old name
# of a formula - transmission, which resolves to the formula transmission-cli -
# silently installs the formula and still reports success. An explicit --cask
# cannot be read two ways. --adopt is what bundle passed on our behalf: without
# it an app already sitting in /Applications is a conflict rather than something
# to take over.
{{ if .packages.brews }}
info "Installing formulae"
brew install {{ range .packages.brews }}{{ . | quote }} {{ end }}
success "Formulae installed"
{{ end }}

{{ if .packages.casks }}
info "Installing casks"
brew install --cask --adopt {{ range .packages.casks }}{{ . | quote }} {{ end }}
success "Casks installed"
{{ end }}

{{ if and .packages.mas .installAppsFromAppStore }}
# mas discovers installed apps through Spotlight. With indexing off it reports an
# empty list, and brew bundle then tries to reinstall everything, which prompts
# for sudo and aborts the run. Skip the block instead of failing the whole apply.
export MAS_NO_AUTO_INDEX=1
if mdutil -s / 2>/dev/null | grep -q "Indexing enabled"; then
	info "Installing MAS apps"
	brew bundle --file=/dev/stdin <<EOF
{{ range $name, $id := .packages.mas }}
mas {{ $name | quote }}, id: {{ $id }}
{{ end }}
EOF
	success "MAS apps installed"
else
	warn "Spotlight indexing is disabled; skipping App Store apps"
fi
{{ end }}

{{ if .packages.vscode }}
info "Installing VSCode extensions"
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.vscode }}
vscode {{ . | quote }}
{{ end }}
EOF
success "VSCode extensions installed"
{{ end }}
