#!/usr/bin/env bash
# Run a command with the machine held awake for as long as it lasts. Wrap any
# long-running foreground process with it: keep-awake claude, keep-awake make.
set -euo pipefail

if [ "$#" -eq 0 ]; then
	printf 'usage: keep-awake <command> [argument...]\n' >&2
	exit 64
fi

# macOS caffeinate needs explicit assertion types. The Linux command only
# accepts a command and inhibits desktop idleness while it runs.
if [ "$(uname -s)" = Darwin ]; then
	exec caffeinate -ims -- "$@"
fi

exec caffeinate -- "$@"
