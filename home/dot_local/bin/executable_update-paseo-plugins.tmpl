#!/usr/bin/env bash
set -euo pipefail

{{ template "log" . }}
# Keeps the plugins from github.com/yegor-usoltsev/paseo-plugins installed in
# Paseo from a checkout in ~/dev, where they can also be edited. The checkout
# only fast-forwards when it is a clean main, so local work is never touched.
# --no-pull keeps existing checkouts in place, preparing dependencies and
# installing missing plugins without fetching source updates.
{{- if eq .chezmoi.os "darwin" }}
export PATH="/opt/homebrew/bin:$PATH"
{{- end }}
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
repo=https://github.com/yegor-usoltsev/paseo-plugins.git
checkout=$HOME/dev/yegor-usoltsev/paseo-plugins
plugins=(peer resume)

pull=true
if [[ ${1:-} == --no-pull ]]; then
	pull=false
fi

paseo=paseo
if ! command -v paseo >/dev/null 2>&1; then
	paseo=/Applications/Paseo.app/Contents/Resources/bin/paseo
	if [[ ! -x $paseo ]]; then
		warn "Skipping the Paseo plugins: no CLI on PATH or in Paseo.app"
		exit 0
	fi
fi

updated=false
if [[ ! -e $checkout/.git ]]; then
	info "Cloning the Paseo plugins"
	git clone --quiet "$repo" "$checkout"
fi

if $pull; then
	if [[ $(git -C "$checkout" branch --show-current) != main || -n $(git -C "$checkout" status --porcelain) ]]; then
		warn "Skipping the Paseo plugins update: $checkout is not a clean main checkout"
	else
		before=$(git -C "$checkout" rev-parse HEAD)
		if git -C "$checkout" pull --quiet --ff-only; then
			[[ $(git -C "$checkout" rev-parse HEAD) == "$before" ]] || updated=true
		else
			warn "Could not update the Paseo plugins checkout"
		fi
	fi
fi

# Plugins are installed through the running daemon; the next run catches up
# when it is stopped.
if ! "$paseo" daemon status --json 2>/dev/null | jq -e '.localDaemon == "running"' >/dev/null; then
	warn "Skipping the Paseo plugins: the local daemon is not running"
	exit 0
fi
installed=$("$paseo" plugin ls --json)
for plugin in "${plugins[@]}"; do
	id=paseo-$plugin
	path=$checkout/$plugin
	prepared=false
	current=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .path' <<<"$installed")
	if ! jq -e --arg id "$id" '.id == $id' "$path/paseo-plugin.json" >/dev/null 2>&1; then
		warn "Cannot install $id: missing or mismatched manifest in $path"
		exit 1
	fi
	# Directory installs do not run the manifest build preparation. Keep the
	# standalone dependencies current before replacing or reloading a plugin.
	if [[ -f $path/package-lock.json ]]; then
		dependencies=$(cksum "$path/package.json" "$path/package-lock.json")
		stamp=$path/node_modules/.paseo-dependencies.cksum
		complete=true
		# Root workspace installs can hoist packages while leaving both stamps.
		while IFS= read -r package; do
			if [[ ! -f $path/$package/package.json ]]; then
				complete=false
				break
			fi
		done < <(jq -r '.packages | keys[] | select(. != "")' "$path/package-lock.json")
		if ! $complete || [[ ! -f $path/node_modules/.package-lock.json || ! -f $stamp || $(cat "$stamp") != "$dependencies" ]]; then
			info "Preparing the Paseo plugin $id dependencies"
			npm ci --prefix "$path" --workspaces=false --omit=dev --ignore-scripts --no-audit --no-fund
			printf '%s\n' "$dependencies" >"$stamp"
			prepared=true
		fi
	fi
	if [[ $current != "$path" ]]; then
		[[ -z $current ]] || "$paseo" plugin remove "$id" >/dev/null
		info "Installing the Paseo plugin $id"
		"$paseo" plugin install "$path" >/dev/null
		success "Paseo plugin $id installed"
	elif $prepared || { $updated && ! git -C "$checkout" diff --quiet "$before" HEAD -- "$plugin"; }; then
		"$paseo" plugin reload "$id" >/dev/null
		success "Paseo plugin $id updated"
	fi
done
