#!/usr/bin/env bash
set -euo pipefail

{{ template "log" . }}
# Update the local plugin checkout, preserving branches and uncommitted work.
# --no-pull prepares and installs the current revision without fetching.
{{- if eq .chezmoi.os "darwin" }}
export PATH="/opt/homebrew/bin:$PATH"
{{- end }}
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
checkout=$HOME/dev/yegor-usoltsev/paseo-plugins
paseo_home=${PASEO_HOME:-$HOME/.paseo}

paseo=paseo
if ! command -v paseo >/dev/null 2>&1; then
	paseo=/Applications/Paseo.app/Contents/Resources/bin/paseo
	if [[ ! -x $paseo ]]; then
		warn "Skipping the Paseo plugin: no CLI on PATH or in Paseo.app"
		exit 0
	fi
fi

updated=false
if [[ ! -e $checkout/.git ]]; then
	info "Cloning the Paseo plugin"
	git clone --quiet https://github.com/yegor-usoltsev/paseo-plugins.git "$checkout"
fi
if [[ ${1:-} != --no-pull ]]; then
	if [[ $(git -C "$checkout" branch --show-current) != main || -n $(git -C "$checkout" status --porcelain) ]]; then
		warn "Skipping the Paseo plugin update: $checkout is not a clean main checkout"
	else
		before=$(git -C "$checkout" rev-parse HEAD)
		if git -C "$checkout" pull --quiet --ff-only; then
			[[ $(git -C "$checkout" rev-parse HEAD) == "$before" ]] || updated=true
		else
			warn "Could not update the Paseo plugin checkout"
		fi
	fi
fi

daemon=$("$paseo" daemon status --home "$paseo_home" --json)
if ! jq -e '.localDaemon == "running"' <<<"$daemon" >/dev/null; then
	warn "Skipping the Paseo plugin: the local daemon is not running"
	exit 0
fi
{{- if eq .chezmoi.os "linux" }}
# mise postinstall fires before upgrade switches latest/lts to the new versions.
# Reconcile here, after the upgrade command has returned.
if jq -e '.desktopManaged != true' <<<"$daemon" >/dev/null; then
	cli_version=$("$paseo" --version)
	node_bin=$(node -p 'process.execPath')
	if jq -e --arg version "$cli_version" --arg node "$node_bin" '.daemonVersion != $version or .daemonNode != $node' <<<"$daemon" >/dev/null; then
		info "Restarting Paseo with the current CLI and Node"
		"$paseo" daemon stop --home "$paseo_home" --force
		env -u MISE_NO_HOOKS -u MISE_INSTALLED_TOOLS "$paseo" daemon start --home "$paseo_home"
	fi
fi
{{- end }}
installed=$("$paseo" plugin ls --home "$paseo_home" --json)
workspace_dirs=$(jq -er '.workspaces[]' "$checkout/package.json")
while IFS= read -r directory; do
	plugin_path=$checkout/$directory
	id=$(jq -er '.id' "$plugin_path/paseo-plugin.json")
	prepared=false
	dependencies=$(cksum "$plugin_path/package.json" "$plugin_path/package-lock.json")
	stamp=$plugin_path/node_modules/.paseo-dependencies.cksum
	complete=true
	# A workspace install may hoist runtime packages while leaving the stamp.
	while IFS= read -r package; do
		if [[ ! -f $plugin_path/$package/package.json ]]; then
			complete=false
			break
		fi
	done < <(jq -r '.packages | to_entries[] | select(.key != "" and .value.dev != true) | .key' "$plugin_path/package-lock.json")
	if ! $complete || [[ ! -f $stamp || $(cat "$stamp") != "$dependencies" ]]; then
		info "Preparing the Paseo plugin $id dependencies"
		npm ci --prefix "$plugin_path" --workspaces=false --omit=dev --ignore-scripts --no-audit --no-fund
		mkdir -p "$plugin_path/node_modules"
		printf '%s\n' "$dependencies" >"$stamp"
		prepared=true
	fi
	current=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .path' <<<"$installed")
	status=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .status' <<<"$installed")
	if [[ $current != "$plugin_path" ]]; then
		[[ -z $current ]] || "$paseo" plugin remove "$id" --home "$paseo_home" >/dev/null
		"$paseo" plugin install "$plugin_path" --home "$paseo_home" >/dev/null
		success "Paseo plugin $id installed"
	elif $prepared || $updated || [[ $status != running ]]; then
		"$paseo" plugin reload "$id" --home "$paseo_home" >/dev/null
		success "Paseo plugin $id updated"
	fi
done <<<"$workspace_dirs"
if jq -e '.[] | select(.id == "paseo-peer")' <<<"$installed" >/dev/null; then
	"$paseo" plugin remove paseo-peer --home "$paseo_home" >/dev/null
	info "Removed paseo-peer; agent messaging is built into Paseo"
fi
