#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf '%s\n' 'usage: p send RECIPIENT MESSAGE...' \
		'       p send RECIPIENT --prompt-file FILE' \
		'       p send RECIPIENT -- MESSAGE...'
}

fail() {
	printf 'p: %s\n' "$1" >&2
	exit "${2:-64}"
}

case ${1:-} in
-h | --help | help)
	usage
	exit 0
	;;
send) shift ;;
*)
	usage >&2
	exit 64
	;;
esac

(($# >= 2)) || fail 'send requires a recipient and a message or --prompt-file'
[[ -n ${PASEO_AGENT_ID:-} ]] || fail 'PASEO_AGENT_ID is not set; run inside a Paseo agent'

recipient=$1
shift
if [[ $recipient == owner ]]; then
	[[ -n ${PASEO_PEER_OWNER_ID:-} ]] || fail 'PASEO_PEER_OWNER_ID is not set'
	recipient=$PASEO_PEER_OWNER_ID
fi
[[ -n $recipient && $recipient != -* ]] || fail 'recipient must be an agent ID'
[[ $recipient != "$PASEO_AGENT_ID" ]] || fail 'refusing to send to the current agent'

message_file=
case $1 in
--prompt-file)
	(($# == 2)) || fail '--prompt-file requires one file and no message arguments'
	[[ -f $2 && -s $2 ]] || fail "prompt file is missing or empty: $2" 66
	message_file=$2
	;;
--)
	shift
	[[ -n $* ]] || fail 'message is empty'
	;;
-*) fail "unknown send option: $1; use -- before a message starting with a dash" ;;
*) [[ -n $* ]] || fail 'message is empty' ;;
esac

paseo_command=paseo
if ! command -v paseo >/dev/null 2>&1; then
	paseo_command=/Applications/Paseo.app/Contents/Resources/bin/paseo
	[[ -x $paseo_command ]] || fail 'paseo is not installed' 127
fi

prompt=$(mktemp "${TMPDIR:-/tmp}/p-send.XXXXXX")
trap 'rm -f "$prompt"' EXIT
printf '[from:%s]\n' "$PASEO_AGENT_ID" >"$prompt"
if [[ -n $message_file ]]; then
	cat "$message_file" >>"$prompt"
else
	printf '%s\n' "$*" >>"$prompt"
fi

"$paseo_command" send --no-wait "$recipient" --prompt-file "$prompt"
