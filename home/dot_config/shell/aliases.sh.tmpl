alias l='eza -lah --group-directories-first'
alias ls='eza --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'

alias cat='bat --paging=never --style=plain'

alias htop='btop'
alias top='btop'

alias lg='lazygit'

alias z='zmx'

alias nano='micro'

{{ if ne .profile "server" -}}
alias ld='lazydocker'

alias cloc='scc'
alias sloc='scc'
alias loc='scc'

# Both CLIs read ~/.agents/RULES.md on every launch and add it to their own
# instructions rather than replacing them: Claude appends to its system prompt,
# Codex supplies it as developer instructions alongside its built-ins.
alias codex='codex --dangerously-bypass-approvals-and-sandbox -c developer_instructions="$(jq -Rs . < "$HOME/.agents/RULES.md")"'
alias claude='claude --dangerously-skip-permissions --append-system-prompt-file "$HOME/.agents/RULES.md"'
{{- end }}
