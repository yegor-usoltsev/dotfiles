alias l='eza -lah --group-directories-first'
alias ls='eza --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'

alias cat='bat --paging=never --style=plain'

alias htop='btop'
alias top='btop'

alias lg='lazygit'

alias nano='micro'

{{ if eq .chezmoi.os "darwin" -}}
unquarantine() {
	if (($# != 1)); then
		echo "Usage: unquarantine <path>" >&2
		return 2
	fi

	/usr/bin/xattr -r -d com.apple.quarantine "$1"
}
{{- end }}

{{ if ne .profile "server" -}}
alias ld='lazydocker'

alias cloc='scc'
alias sloc='scc'
alias loc='scc'

# keep-awake holds the machine open for the whole session, including the time
# an agent spends waiting for the next turn.
alias codex='keep-awake codex --dangerously-bypass-approvals-and-sandbox'
alias claude='keep-awake claude --dangerously-skip-permissions'
{{- end }}
