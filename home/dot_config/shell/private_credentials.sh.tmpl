{{- with dig "droneToken" "" .secrets -}}
export DRONE_SERVER="https://drone.usoltsev.xyz"
export DRONE_TOKEN={{ . | shellQuote }}
{{ end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   with dig "githubToken" "" .secrets -}}
# Homebrew uses the shared token for its API and private registry bottles.
export HOMEBREW_GITHUB_API_TOKEN={{ . | shellQuote }}
export HOMEBREW_GITHUB_PACKAGES_TOKEN={{ . | shellQuote }}
export HOMEBREW_GITHUB_PACKAGES_USER=yegor-usoltsev
{{   end -}}
{{- end -}}
