{{ with dig "droneToken" "" .secrets -}}
export DRONE_SERVER="https://drone.usoltsev.xyz"
export DRONE_TOKEN={{ . | shellQuote }}
{{ end -}}
{{ with dig "cloudflareApiToken" "" .secrets -}}
export CLOUDFLARE_ACCOUNT_ID={{ dig "cloudflareAccountId" "" $.secrets | shellQuote }}
export CLOUDFLARE_API_TOKEN={{ . | shellQuote }}
{{ end -}}
